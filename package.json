{
  "author": "Timothy B. Smith",
  "license": "ISC",
  "name": "dotfiles",
  "version": "1.5.0",
  "description": "My dotfiles",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thexavismith/dotfiles.git"
  },
  "keywords": [
    "dotfiles",
    "shell",
    "scripts"
  ],
  "homepage": "https://github.com/thexavismith/dotfiles#readme",
  "bugs": {
    "url": "https://github.com/thexavismith/dotfiles/issues"
  },
  "scripts": {
    "prepare": "husky install",
    "release": "npx semantic-release",
    "install:dotfiles": "./script/bootstrap"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-angular": "^20.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.3"
  },
  "release": {
    "branches": [
      "default"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "type": "docs",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": "patch"
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
